{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.example.invalid/schemas/pattern-source-plan.v1.schema.json",
  "title": "Tycho pattern source plan v1",
  "description": "Planned source units and honest read/planned/blocked states. Not evidence of reading or technical truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated",
    "registry_version",
    "registry_sha256",
    "route_index_snapshot",
    "policy",
    "foundation_records",
    "entries",
    "summary",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "route_index_snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_rule",
        "read_rule",
        "unread_rule",
        "reuse_rule"
      ],
      "properties": {
        "unit_rule": {
          "type": "string",
          "minLength": 1
        },
        "read_rule": {
          "type": "string",
          "minLength": 1
        },
        "unread_rule": {
          "type": "string",
          "minLength": 1
        },
        "reuse_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foundation_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^read\\.[a-z0-9-]+\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 145,
      "maxItems": 145,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "required_units",
        "read_units",
        "planned_units",
        "blocked_units",
        "ledger_records"
      ],
      "properties": {
        "entries": {
          "const": 145
        },
        "required_units": {
          "type": "integer",
          "minimum": 145
        },
        "read_units": {
          "type": "integer",
          "minimum": 0
        },
        "planned_units": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_units": {
          "type": "integer",
          "minimum": 0
        },
        "ledger_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "unit",
        "unit_type",
        "url",
        "sections",
        "status",
        "read_record_id",
        "blocked_reason"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_type": {
          "enum": [
            "catalog-index",
            "pattern-page",
            "article",
            "book-chapter",
            "documentation-page",
            "specification",
            "engineering-article",
            "paper"
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "read",
            "planned",
            "blocked"
          ]
        },
        "read_record_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^read\\.[a-z0-9-]+\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "read"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "read_record_id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "blocked_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "planned"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "read_record_id": {
                "type": "null"
              },
              "blocked_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "read_record_id": {
                "type": "null"
              },
              "blocked_reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "catalog_name",
        "priority",
        "required_units",
        "notes"
      ],
      "properties": {
        "pattern_id": {
          "type": "string",
          "pattern": "^tycho\\.pattern\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "catalog_name": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "core",
            "advanced"
          ]
        },
        "required_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unit"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
