{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.example.invalid/schemas/v12/manifest.v1.schema.json",
  "title": "V12 volume manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "authorization",
    "baseline_commit",
    "task_issue",
    "epic_issue",
    "volume",
    "chapters",
    "documents",
    "page_policy",
    "review_scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "self-checked",
        "independent-reviewed"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "activated_at",
        "scope",
        "iron_rule",
        "protected_baseline"
      ],
      "properties": {
        "issue": {
          "const": 587
        },
        "activated_at": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "minLength": 20
        },
        "iron_rule": {
          "type": "string",
          "minLength": 20
        },
        "protected_baseline": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_issue": {
      "const": 587
    },
    "epic_issue": {
      "const": 587
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "code": {
          "const": "V12"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "id": {
          "type": "string",
          "pattern": "^tycho\\.volume\\.[a-z0-9]{6,32}$"
        },
        "path": {
          "type": "string",
          "pattern": "^book/.*\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "title",
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^V12/C[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "id": {
            "type": "string",
            "pattern": "^tycho\\.chapter\\.[a-z0-9]{6,32}$"
          },
          "path": {
            "type": "string",
            "pattern": "^book/.*\\.md$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "parent_id",
          "path",
          "title",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tycho\\.(volume|chapter|page)\\.[a-z0-9]{6,32}$"
          },
          "kind": {
            "enum": [
              "volume",
              "chapter",
              "page"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^book/volumes/v12-.*\\.md$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "page_policy": {
      "type": "string",
      "minLength": 20
    },
    "review_scope": {
      "type": "string",
      "minLength": 20
    }
  }
}
