{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.example.invalid/schemas/v12/model-specification.v1.schema.json",
  "title": "V12 model specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "purpose",
    "scope",
    "abstraction",
    "state_variables",
    "parameters",
    "dynamics",
    "invariants",
    "verification",
    "calibration",
    "validity_limits",
    "assumptions",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^tycho\\.model\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 140
    },
    "purpose": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "excludes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "abstraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_unit",
        "state_unit",
        "boundary",
        "resolution"
      ],
      "properties": {
        "time_unit": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day"
          ]
        },
        "state_unit": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 20
        },
        "resolution": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "state_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "unit",
          "description",
          "non_negative"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "non_negative": {
            "type": "boolean"
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "unit",
          "value_type",
          "evidence_status",
          "source_ids",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "enum": [
              "number",
              "integer",
              "boolean",
              "string",
              "distribution"
            ]
          },
          "default": {
            "type": [
              "number",
              "integer",
              "boolean",
              "string",
              "null"
            ]
          },
          "evidence_status": {
            "enum": [
              "measured",
              "assumed",
              "derived",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^src\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "measurement": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "method",
              "sample_size",
              "period"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 10
              },
              "sample_size": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "period": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 4
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 10,
            "maxLength": 800
          }
        }
      }
    },
    "dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "equations",
        "time_step"
      ],
      "properties": {
        "kind": {
          "enum": [
            "stock-flow",
            "discrete-event",
            "hybrid"
          ]
        },
        "equations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "time_step": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "statement",
          "check"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "check": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cases",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "partially-verified",
            "model-verified"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "expected",
              "observed",
              "status",
              "test_path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "description": {
                "type": "string",
                "minLength": 20
              },
              "expected": {
                "type": "string",
                "minLength": 5
              },
              "observed": {
                "type": "string",
                "minLength": 5
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not-run"
                ]
              },
              "test_path": {
                "type": "string",
                "pattern": "^tests/test_tycho_v12[a-z0-9_]*\\.py$"
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1200
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "uncalibrated",
            "partially-calibrated",
            "calibrated"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "status",
              "source_ids",
              "note"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "status": {
                "enum": [
                  "measured",
                  "assumed",
                  "derived",
                  "unknown"
                ]
              },
              "source_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^src\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "note": {
                "type": "string",
                "minLength": 10,
                "maxLength": 600
              }
            }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1200
        }
      }
    },
    "validity_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 15
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
