{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.example.invalid/schemas/v12/run-result.v1.schema.json",
  "title": "V12 run result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "model_id",
    "scenario_id",
    "engine",
    "provenance",
    "metrics",
    "convergence",
    "uncertainty",
    "sensitivity",
    "limitations",
    "invariants",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^tycho\\.run\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^tycho\\.model\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^tycho\\.scenario\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "deterministic"
      ],
      "properties": {
        "name": {
          "const": "tycho-v12-reference-engine"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "deterministic": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_sha256",
        "scenario_sha256",
        "seed_base",
        "replications",
        "input_sha256",
        "python",
        "platform",
        "invocation",
        "engine_sha256"
      ],
      "properties": {
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenario_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_base": {
          "type": "integer",
          "minimum": 0
        },
        "replications": {
          "type": "integer",
          "minimum": 2
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "python": {
          "type": "string",
          "minLength": 3
        },
        "platform": {
          "type": "string",
          "minLength": 3
        },
        "invocation": {
          "type": "string",
          "minLength": 10
        },
        "engine_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "unit",
          "replications",
          "standard_error",
          "ci_low",
          "ci_high"
        ],
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "replications": {
            "type": "integer",
            "minimum": 2
          },
          "standard_error": {
            "type": "number",
            "minimum": 0
          },
          "ci_low": {
            "type": "number"
          },
          "ci_high": {
            "type": "number"
          }
        }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "metric",
        "relative_error",
        "threshold",
        "replications"
      ],
      "properties": {
        "status": {
          "enum": [
            "converged",
            "insufficient-sample"
          ]
        },
        "metric": {
          "type": "string",
          "minLength": 3
        },
        "relative_error": {
          "type": "number",
          "minimum": 0
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "replications": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "draws",
        "correlated_inputs",
        "notes"
      ],
      "properties": {
        "method": {
          "enum": [
            "replication",
            "parametric-bootstrap",
            "gaussian-copula"
          ]
        },
        "draws": {
          "type": "integer",
          "minimum": 0
        },
        "correlated_inputs": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter",
          "first_order_index",
          "total_order_index",
          "method"
        ],
        "properties": {
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "first_order_index": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "total_order_index": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "method": {
            "enum": [
              "pick-freeze",
              "quadratic-response-surface"
            ]
          },
          "replications": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 15
      }
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conservation_ok",
        "checks"
      ],
      "properties": {
        "conservation_ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3
              },
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    }
  }
}
