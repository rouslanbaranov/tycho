{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.example.invalid/schemas/v12/scenario-specification.v1.schema.json",
  "title": "V12 scenario specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "model_id",
    "purpose",
    "workload",
    "configuration",
    "uncertainty",
    "replications",
    "seed",
    "metrics",
    "constraints",
    "evidence_status",
    "validity_limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^tycho\\.scenario\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "model_id": {
      "type": "string",
      "pattern": "^tycho\\.model\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "warmup",
        "time_unit",
        "arrival_process"
      ],
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "warmup": {
          "type": "number",
          "minimum": 0
        },
        "time_unit": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day"
          ]
        },
        "arrival_process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rate",
            "unit"
          ],
          "properties": {
            "kind": {
              "enum": [
                "poisson",
                "deterministic",
                "trace"
              ]
            },
            "rate": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "minLength": 3
            },
            "trace": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "servers",
        "service_time",
        "queue_capacity",
        "timeout",
        "max_attempts",
        "retry_backoff",
        "bulkhead",
        "cost_per_server_hour"
      ],
      "properties": {
        "servers": {
          "type": "integer",
          "minimum": 0
        },
        "service_time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mean",
            "cv"
          ],
          "properties": {
            "kind": {
              "enum": [
                "exponential",
                "lognormal",
                "deterministic"
              ]
            },
            "mean": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cv": {
              "type": "number",
              "minimum": 0.01
            }
          }
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "retry_backoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base",
            "jitter"
          ],
          "properties": {
            "kind": {
              "enum": [
                "none",
                "exponential",
                "linear"
              ]
            },
            "base": {
              "type": "number",
              "minimum": 0
            },
            "jitter": {
              "enum": [
                "none",
                "full",
                "equal"
              ]
            }
          }
        },
        "bulkhead": {
          "type": "integer",
          "minimum": 1
        },
        "cost_per_server_hour": {
          "type": "number",
          "minimum": 0
        },
        "target_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "target_capacity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "legacy_capacity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dual_write_lag": {
          "type": "number",
          "minimum": 0
        },
        "reconciliation_capacity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rollback_at": {
          "type": "number",
          "minimum": 0
        },
        "rollback_drain": {
          "type": "number",
          "minimum": 0
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "target_share"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "target_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_draws",
        "correlations"
      ],
      "properties": {
        "parameter_draws": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "distribution",
              "unit"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "distribution": {
                "enum": [
                  "normal",
                  "uniform",
                  "lognormal",
                  "fixed"
                ]
              },
              "mean": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "sd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "low": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "high": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "correlations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right",
              "coefficient"
            ],
            "properties": {
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "coefficient": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "replications": {
      "type": "integer",
      "minimum": 2,
      "maximum": 10000
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "scheme"
      ],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "scheme": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit",
          "direction",
          "business_comparable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "higher",
              "lower",
              "target"
            ]
          },
          "business_comparable": {
            "const": true
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "hard",
              "soft",
              "non-quantitative"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "evidence_status": {
      "enum": [
        "assumed",
        "measured",
        "mixed"
      ]
    },
    "validity_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 15
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^tycho\\.run\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
