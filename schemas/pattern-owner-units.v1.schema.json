{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.dev/schemas/pattern-owner-units.v1.schema.json",
  "title": "Tycho pattern owner units and coverage evidence v1",
  "description": "Section-level technical ownership and per-entry coverage evidence for carded catalog entries. Structural checks only; not independent review, sufficient coverage or technical truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "audit_date",
    "scope",
    "method",
    "coverage_rules",
    "entries",
    "shared_pages",
    "summary",
    "split_deferrals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "owner-units-audited"
      ]
    },
    "audit_date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "coverage_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical",
        "decision",
        "review"
      ],
      "properties": {
        "technical": {
          "$ref": "#/$defs/rule"
        },
        "decision": {
          "$ref": "#/$defs/rule"
        },
        "review": {
          "$ref": "#/$defs/rule"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 145,
      "maxItems": 145,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "shared_pages": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {
        "$ref": "#/$defs/sharedPage"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "split_deferrals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0,
      "items": {
        "$ref": "#/$defs/splitDeferral"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "enum": [
        "supported",
        "partial",
        "absent"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "quote": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "catalog_name",
        "family",
        "owner",
        "technical_evidence",
        "decision_evidence",
        "source_support",
        "review_state",
        "technical_coverage",
        "decision_coverage",
        "notes"
      ],
      "properties": {
        "pattern_id": {
          "type": "string",
          "pattern": "^tycho\\.pattern\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "catalog_name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "technical_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism",
            "invariant",
            "failure_recovery",
            "alternative"
          ],
          "properties": {
            "mechanism": {
              "$ref": "#/$defs/evidence"
            },
            "invariant": {
              "$ref": "#/$defs/evidence"
            },
            "failure_recovery": {
              "$ref": "#/$defs/evidence"
            },
            "alternative": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "decision_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "atlas_section",
            "question",
            "competing_alternative",
            "decision_state",
            "card_components"
          ],
          "properties": {
            "atlas_section": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "competing_alternative": {
              "type": "string",
              "minLength": 1
            },
            "decision_state": {
              "enum": [
                "applicable-under-conditions",
                "candidate",
                "contraindicated",
                "insufficient-evidence",
                "not-required"
              ]
            },
            "card_components": {
              "type": "integer",
              "minimum": 10,
              "maximum": 10
            }
          }
        },
        "source_support": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ledger_record",
            "source_id",
            "unit_type",
            "status",
            "card_citation"
          ],
          "properties": {
            "ledger_record": {
              "type": "string",
              "minLength": 1
            },
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "unit_type": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "read"
              ]
            },
            "card_citation": {
              "const": true
            }
          }
        },
        "review_state": {
          "enum": [
            "self-checked",
            "independent-reviewed"
          ]
        },
        "technical_coverage": {
          "enum": [
            "partial-reviewed",
            "partial-bounded",
            "partial",
            "name-only"
          ]
        },
        "decision_coverage": {
          "enum": [
            "partial-reviewed",
            "partial-bounded",
            "partial",
            "name-only"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "heading",
        "anchor",
        "level",
        "line",
        "unit_kind",
        "unit_terms"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^tycho\\.(book|volume|chapter|page|landing|decision)\\.[a-z0-9]{6,32}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "level": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "unit_kind": {
          "enum": [
            "dedicated",
            "embedded"
          ]
        },
        "unit_terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 60
          }
        }
      }
    },
    "sharedPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "pattern_count",
        "pattern_ids",
        "unit_count",
        "dedicated_units",
        "bounded_entries",
        "decision",
        "rationale"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pattern_count": {
          "type": "integer",
          "minimum": 2
        },
        "pattern_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unit_count": {
          "type": "integer",
          "minimum": 1
        },
        "dedicated_units": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_entries": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "enum": [
            "keep",
            "deepen",
            "split"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 60,
          "maxLength": 600
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "owner_pages",
        "shared_pages",
        "owner_units",
        "dedicated_units",
        "embedded_units",
        "mechanism_supported",
        "invariant_supported",
        "failure_recovery_supported",
        "alternative_supported",
        "technical_partial_bounded",
        "technical_partial",
        "technical_name_only",
        "technical_sufficient",
        "decision_partial_bounded",
        "decision_partial",
        "decision_name_only",
        "decision_sufficient",
        "partial_reviewed",
        "independent_reviews",
        "shared_page_decisions",
        "split_deferred"
      ],
      "properties": {
        "entries": {
          "const": 145
        },
        "owner_pages": {
          "const": 69
        },
        "shared_pages": {
          "const": 33
        },
        "owner_units": {
          "type": "integer",
          "minimum": 30
        },
        "dedicated_units": {
          "type": "integer",
          "minimum": 0,
          "const": 69
        },
        "embedded_units": {
          "type": "integer",
          "minimum": 0,
          "const": 51
        },
        "mechanism_supported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "invariant_supported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "failure_recovery_supported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "alternative_supported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "technical_partial_bounded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "technical_partial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "technical_name_only": {
          "const": 0
        },
        "technical_sufficient": {
          "const": 0
        },
        "decision_partial_bounded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "decision_partial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 145
        },
        "decision_name_only": {
          "const": 0
        },
        "decision_sufficient": {
          "const": 0
        },
        "partial_reviewed": {
          "const": 0
        },
        "independent_reviews": {
          "const": 0
        },
        "shared_page_decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keep",
            "deepen",
            "split"
          ],
          "properties": {
            "keep": {
              "type": "integer",
              "minimum": 0
            },
            "deepen": {
              "type": "integer",
              "minimum": 0
            },
            "split": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "split_deferred": {
          "const": 0
        }
      }
    },
    "splitDeferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "pattern_ids",
        "decision",
        "rationale",
        "gate"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pattern_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "const": "deferred"
        },
        "rationale": {
          "type": "string",
          "minLength": 60,
          "maxLength": 600
        },
        "gate": {
          "type": "string",
          "minLength": 40,
          "maxLength": 400
        }
      }
    }
  }
}
