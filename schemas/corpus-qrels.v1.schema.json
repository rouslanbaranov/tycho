{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.example.invalid/schemas/corpus-qrels.v1.schema.json",
  "title": "Tycho corpus-level retrieval relevance judgments v1",
  "description": "Accepted-answer sets for lexical retrieval evaluation. Schema syntax checks are not independent relevance adjudication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "created",
    "snapshot",
    "target_item_count",
    "provenance",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "bootstrap-author-labelled",
        "author-labelled",
        "independently-reviewed"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_index_snapshot",
        "document_count"
      ],
      "properties": {
        "route_index_snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "target_item_count": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "method",
        "independent_review",
        "review_note"
      ],
      "properties": {
        "labels": {
          "enum": [
            "author-labelled",
            "independently-reviewed"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 20
        },
        "independent_review": {
          "type": "boolean"
        },
        "review_note": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "split",
        "category",
        "question",
        "accepted",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q[0-9]{3}$"
        },
        "split": {
          "enum": [
            "dev",
            "heldout"
          ]
        },
        "category": {
          "enum": [
            "fact",
            "synthesis",
            "tradeoff",
            "failure",
            "change_impact",
            "contradiction",
            "unanswerable"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 15
        },
        "accepted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "unanswerable"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "accepted": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "category": {
                  "const": "unanswerable"
                }
              },
              "required": [
                "category"
              ]
            }
          },
          "then": {
            "properties": {
              "accepted": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "section_id",
        "grade",
        "rationale"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^tycho\\.(book|volume|chapter|page|landing|decision)\\.[a-z0-9]{6,32}$"
        },
        "path": {
          "type": "string",
          "pattern": "^book/[A-Za-z0-9._/-]+\\.md$"
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
        },
        "grade": {
          "enum": [
            1,
            2
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
