{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.example.invalid/schemas/pattern-registry.v1.schema.json",
  "title": "Tycho pattern registry v1",
  "description": "Catalog membership, aliases, ownership and coverage state. Structural checks only; not technical truth, source inspection or review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "edition_version",
    "status",
    "updated_at",
    "catalog",
    "atlas",
    "families",
    "patterns",
    "source_policy",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "edition_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+-rc\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "accepted"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "title",
        "entry_count",
        "family_count",
        "core_count",
        "advanced_count",
        "captured_at",
        "source",
        "order_note"
      ],
      "properties": {
        "issue": {
          "const": 228
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "entry_count": {
          "const": 145
        },
        "family_count": {
          "const": 11
        },
        "core_count": {
          "const": 123
        },
        "advanced_count": {
          "const": 22
        },
        "captured_at": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "order_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume_code",
        "volume_path",
        "volume_title",
        "status",
        "page_policy",
        "chapter_count"
      ],
      "properties": {
        "volume_code": {
          "const": "V11"
        },
        "volume_path": {
          "const": "book/volumes/v11-pattern-atlas"
        },
        "volume_title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "scaffolded",
            "authoring",
            "reviewed"
          ]
        },
        "page_policy": {
          "type": "string",
          "minLength": 1
        },
        "chapter_count": {
          "const": 11
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 145,
      "maxItems": 145,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission",
        "reading_unit",
        "unread_citations",
        "blocked_sources",
        "reuse_issue_225"
      ],
      "properties": {
        "admission": {
          "type": "string",
          "minLength": 1
        },
        "reading_unit": {
          "type": "string",
          "minLength": 1
        },
        "unread_citations": {
          "const": "forbidden"
        },
        "blocked_sources": {
          "type": "string",
          "minLength": 1
        },
        "reuse_issue_225": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_at",
        "reviewer",
        "independent_review",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "self-checked",
            "independent-reviewed",
            "owner-accepted"
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "independent_review": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "coverageState": {
      "enum": [
        "sufficient",
        "partial-reviewed",
        "partial-bounded",
        "partial",
        "name-only",
        "missing",
        "contradictory",
        "not-yet-assessed",
        "not-applicable"
      ]
    },
    "patternId": {
      "type": "string",
      "pattern": "^tycho\\.pattern\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^tycho\\.(book|volume|chapter|page|landing|decision)\\.[a-z0-9]{6,32}$"
    },
    "anchor": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "chapterCode": {
      "type": "string",
      "pattern": "^V11/C(0[1-9]|1[01])$"
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "chapter",
        "chapter_path",
        "pattern_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "$ref": "#/$defs/chapterCode"
        },
        "chapter_path": {
          "type": "string",
          "pattern": "^book/volumes/v11-pattern-atlas/c(0[1-9]|1[01])-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "pattern_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/patternId"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pattern_id",
        "note"
      ],
      "properties": {
        "type": {
          "enum": [
            "related",
            "overlaps",
            "alternative-to",
            "depends-on",
            "conflicts-with"
          ]
        },
        "pattern_id": {
          "$ref": "#/$defs/patternId"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "technicalOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "path",
        "anchor",
        "state"
      ],
      "properties": {
        "document_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/documentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^book/.*\\.md$"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/coverageState"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "document_id": {
                "type": "null"
              }
            },
            "required": [
              "document_id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "null"
              },
              "anchor": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "document_id": {
                "type": "string"
              }
            },
            "required": [
              "document_id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "atlasOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "section",
        "state"
      ],
      "properties": {
        "chapter": {
          "$ref": "#/$defs/chapterCode"
        },
        "section": {
          "$ref": "#/$defs/anchor"
        },
        "state": {
          "$ref": "#/$defs/coverageState"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical",
        "decision",
        "overall"
      ],
      "properties": {
        "technical": {
          "$ref": "#/$defs/coverageState"
        },
        "decision": {
          "$ref": "#/$defs/coverageState"
        },
        "overall": {
          "$ref": "#/$defs/coverageState"
        }
      }
    },
    "sourceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "unit",
        "status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src\\.[a-z0-9][a-z0-9-]*$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not-read",
            "blocked",
            "partial",
            "read"
          ]
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "catalog_name",
        "catalog_order",
        "family",
        "kind",
        "priority",
        "catalog_problem",
        "aliases",
        "relations",
        "atlas_section",
        "technical_owner",
        "atlas_owner",
        "coverage",
        "confidence",
        "source_units",
        "review_status",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/patternId"
        },
        "catalog_name": {
          "type": "string",
          "minLength": 1
        },
        "catalog_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 145
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "architecture-style",
            "pattern",
            "mechanism",
            "practice"
          ]
        },
        "priority": {
          "enum": [
            "core",
            "advanced"
          ]
        },
        "catalog_problem": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "atlas_section": {
          "$ref": "#/$defs/anchor"
        },
        "technical_owner": {
          "$ref": "#/$defs/technicalOwner"
        },
        "atlas_owner": {
          "$ref": "#/$defs/atlasOwner"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "source_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceUnit"
          }
        },
        "review_status": {
          "enum": [
            "not-assessed",
            "self-checked",
            "independent-reviewed",
            "owner-accepted"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
