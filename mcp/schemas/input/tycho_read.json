{
  "additionalProperties": false,
  "properties": {
    "budget_chars": {
      "default": 2500,
      "description": "Maximum codepoints to return.",
      "maximum": 6000,
      "minimum": 1,
      "type": "integer"
    },
    "include_evidence": {
      "default": false,
      "description": "Attach registered document evidence.",
      "type": "boolean"
    },
    "offset": {
      "default": 0,
      "description": "Codepoint offset inside the section.",
      "minimum": 0,
      "type": "integer"
    },
    "section_key": {
      "description": "Section key returned by tycho_search.",
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "snapshot_id": {
      "description": "Optional snapshot pin for consistency.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "section_key"
  ],
  "type": "object"
}
