{
  "schema_version": 1,
  "id": "tycho.scenario.checkout-convergence-stress",
  "version": "1.0.0",
  "title": "Checkout convergence stress - two-replication screening run",
  "model_id": "tycho.model.checkout-des",
  "purpose": "Exercise the insufficient-sample outcome with a deliberately small replication budget and wide arrival and service-time draws near the capacity boundary.",
  "workload": {
    "duration": 300.0,
    "warmup": 60.0,
    "time_unit": "second",
    "arrival_process": {
      "kind": "poisson",
      "rate": 22.0,
      "unit": "request/second"
    }
  },
  "configuration": {
    "servers": 8,
    "service_time": {
      "kind": "lognormal",
      "mean": 0.4,
      "cv": 0.8
    },
    "queue_capacity": 20,
    "timeout": 1.0,
    "max_attempts": 1,
    "retry_backoff": {
      "kind": "none",
      "base": 0.0,
      "jitter": "none"
    },
    "bulkhead": 25,
    "cost_per_server_hour": 10.0
  },
  "uncertainty": {
    "parameter_draws": [
      {
        "parameter": "arrival_rate",
        "distribution": "normal",
        "mean": 22.0,
        "sd": 15.0,
        "unit": "request/second"
      },
      {
        "parameter": "service_mean",
        "distribution": "normal",
        "mean": 0.4,
        "sd": 0.3,
        "unit": "second/request"
      }
    ],
    "correlations": [
      {
        "left": "arrival_rate",
        "right": "service_mean",
        "coefficient": 0.3
      }
    ]
  },
  "replications": 2,
  "seed": {
    "base": 20261029,
    "scheme": "seed = base + replication index"
  },
  "metrics": [
    {
      "id": "success_rate",
      "unit": "ratio",
      "direction": "higher",
      "business_comparable": true
    },
    {
      "id": "latency_p95",
      "unit": "second",
      "direction": "lower",
      "business_comparable": true
    },
    {
      "id": "throughput",
      "unit": "request/second",
      "direction": "higher",
      "business_comparable": true
    },
    {
      "id": "cost_per_1k_success",
      "unit": "cost-unit/1000 successes",
      "direction": "lower",
      "business_comparable": true
    },
    {
      "id": "rejection_rate",
      "unit": "ratio",
      "direction": "lower",
      "business_comparable": true
    },
    {
      "id": "retry_amplification",
      "unit": "ratio",
      "direction": "lower",
      "business_comparable": true
    }
  ],
  "constraints": [
    {
      "id": "C1",
      "kind": "hard",
      "statement": "A candidate must not silently drop a request without recording a rejection or failure."
    },
    {
      "id": "C2",
      "kind": "hard",
      "statement": "A candidate must preserve request conservation under the synthetic workload."
    },
    {
      "id": "C3",
      "kind": "non-quantitative",
      "statement": "A candidate must remain operable by the existing team without a new platform dependency."
    }
  ],
  "evidence_status": "assumed",
  "validity_limits": [
    "Synthetic workload only; no production trace or measurement is represented.",
    "The candidate comparison is conditional on the declared configuration and seeds."
  ],
  "run_id": "tycho.run.checkout-convergence-stress"
}
