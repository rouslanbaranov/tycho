{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tycho.local/schemas/agent-judge-v2.1.json",
  "title": "Tycho claim-level judge output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "items"],
  "properties": {
    "status": {"const": "ai-judge-not-human"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "citation_resolution", "required_anchor_coverage",
                     "claim_verdicts", "semantic_support", "core_coverage",
                     "pass", "notes"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^Q[0-9]{3}$"},
          "citation_resolution": {"type": "boolean"},
          "required_anchor_coverage": {"type": "number", "minimum": 0, "maximum": 1},
          "claim_verdicts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "core", "verdict", "quote_id", "reason"],
              "properties": {
                "claim_id": {"type": "string", "pattern": "^C[0-9]+$"},
                "core": {"type": "boolean"},
                "verdict": {"enum": ["supported", "partial", "unsupported"]},
                "quote_id": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "semantic_support": {"type": "integer", "minimum": 0, "maximum": 2},
          "core_coverage": {"type": "integer", "minimum": 0, "maximum": 2},
          "pass": {"type": "boolean"},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
